{
  "name": "promptforge",
  "version": "1.0.0",
  "description": "AI Prompt Management Tool for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --x64 --arm64 --publish never",
    "build:win-x64": "electron-builder --win --x64 --publish never",
    "build:win-arm64": "electron-builder --win --arm64 --publish never"
  },
  "build": {
    "appId": "com.promptforge.app",
    "productName": "PromptForge",
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": ["prompt", "ai", "productivity"],
  "author": "PromptForge",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
